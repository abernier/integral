    "lgtm": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@classcad/mcp": "0.6.1",
    "@classcad/renderer": "0.1.0",
    "@classcad/script": "0.2.0",
    "@classcad/skill": "0.0.8",
    "@classcad/smlibwasm": "^0.6.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pmndrs/docs": "4.27.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "camera-controls": "^3.1.2",
    "leva": "^0.10.1",
    "material-theme-builder": "5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
