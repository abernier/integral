{
  "name": "integral",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:parts": "node scripts/build.ts --parts-only",
    "cam": "node scripts/cam.ts",
    "dev": "node scripts/dev.ts",
    "typecheck": "tsc --noEmit",
